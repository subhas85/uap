[Unit]
Description=herdr sysmeter — publish host CPU%%/RAM%% to the herdr sidebar
Documentation=https://github.com/subhas85/uap/blob/main/ai/herdr/README.md
After=default.target

[Service]
Type=simple
# sysmeter.sh calls `herdr` by name, but a systemd --user unit does NOT inherit
# the login shell's PATH — it gets the manager's default, which has no
# ~/.local/bin, which is exactly where apply.sh installs herdr. The lookup then
# returns empty and the script's `[ -n "$wid" ]` guard silently skips reporting:
# the service sits there `active` forever, publishing nothing, with no error.
# (The older i3 `exec_always` launch never hit this — it inherits the session PATH.)
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
ExecStart=%h/.local/bin/herdr-sysmeter
Restart=on-failure
RestartSec=10
# The reporter is a ~5s poll loop; keep it out of the way of real work.
Nice=10

[Install]
WantedBy=default.target
