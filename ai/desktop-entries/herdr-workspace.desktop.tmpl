[Desktop Entry]
Type=Application
Name=Herdr (terminal workspace)
GenericName=Terminal Workspace Manager
Comment=Attach to the persistent Herdr terminal and agent workspace in ~/${WORKSPACE_HUB_NAME}
Exec=alacritty --working-directory ${HOME_DIR}/${WORKSPACE_HUB_NAME} -e herdr
Icon=utilities-terminal
Terminal=false
Categories=System;TerminalEmulator;
Keywords=herdr;terminal;agent;workspace;multiplexer;claude;ai;
StartupNotify=false
