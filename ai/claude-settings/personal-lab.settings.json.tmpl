{
  "defaultMode": "bypassPermissions",
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "_deny_comment": "File-path protection uses Edit(...) only \u2014 Edit rules cover every file-writing tool (Write, Edit, NotebookEdit). Write(path) rules are NOT enforced by the file-permission engine and make Claude Code warn at startup; do not add them.",
    "allow": [],
    "ask": [],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(dd if=* of=/dev/sd*)",
      "Edit(~/.ssh/id_*)",
      "Edit(~/.ssh/*_rsa)",
      "Edit(~/.ssh/*_ed25519)",
      "Edit(~/.gnupg/private-keys-v1.d/**)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.claude.json)",
      "Edit(~/.claude/credentials*)"
    ]
  }
}
